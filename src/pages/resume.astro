---
/* Resume — dedicated view rendering experience, skills, and education. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Resume from '../components/Resume.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`Resume — ${site.name}`}
  description={`Resume of ${site.name}: experience, skills, and education.`}
>
  <span id="top"></span>
  <Header />
  <main>
    <div class="container">
      <div class="toolbar" data-reveal>
        <Button href="/resume.pdf" variant="accent-3" size="sm" download>Download PDF</Button>
      </div>
      <Resume />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .toolbar {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-8);
  }
</style>
