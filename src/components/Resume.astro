---
/* Online resume: composes experience, education, and skills from resume.json. */
import { resume } from '../data/resume';
import { formatDateRange } from '../lib/dates';
import ExperienceItem from './ExperienceItem.astro';
import SkillList from './SkillList.astro';
---

<section id="resume" class="resume">
  <h2>Resume</h2>

  <div class="block">
    <h3 class="block-title bw-tape">Experience</h3>
    <div class="experience-list">
      {resume.work.map((item) => <ExperienceItem item={item} />)}
    </div>
  </div>

  {
    resume.skills.length > 0 && (
      <div class="block">
        <h3 class="block-title bw-tape">Skills</h3>
        <SkillList groups={resume.skills} />
      </div>
    )
  }

  {
    resume.education.length > 0 && (
      <div class="block">
        <h3 class="block-title bw-tape">Education</h3>
        <ul class="education-list">
          {resume.education.map((edu) => {
            const credential = [edu.studyType, edu.area].filter(Boolean).join(', ');
            const dates = formatDateRange(edu.startDate ?? '', edu.endDate);
            return (
              <li>
                <span class="school">{edu.institution}</span>
                {credential && <span class="credential">{credential}</span>}
                {(edu.startDate || edu.endDate) && <span class="dates">{dates}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>

<style>
  .resume {
    padding-block: var(--space-16);
    border-top: var(--border-bold) solid var(--border-strong);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-10);
  }

  .block + .block {
    margin-top: var(--space-16);
  }

  /* Stamped tape-label section markers (.bw-tape owns the look). */
  .block-title {
    margin-bottom: var(--space-8);
  }

  .experience-list {
    display: grid;
    gap: var(--space-10);
  }

  .education-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .education-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .school {
    font-weight: var(--weight-bold);
    color: var(--text-strong);
  }

  .credential {
    color: var(--text-secondary);
  }

  .education-list .dates {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
