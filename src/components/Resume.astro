---
/* Online resume: composes experience, education, and skills from resume.json. */
import { resume } from '../data/resume';
import { formatDateRange } from '../lib/dates';
import ExperienceItem from './ExperienceItem.astro';
import SkillList from './SkillList.astro';
---

<section id="resume" class="resume">
  <h2>Resume</h2>

  <div class="block">
    <h3 class="block-title bw-tape">Experience</h3>
    <div class="experience-list">
      {resume.work.map((item) => <ExperienceItem item={item} />)}
    </div>
  </div>

  {
    resume.skills.length > 0 && (
      <div class="block">
        <h3 class="block-title bw-tape">Skills</h3>
        <SkillList groups={resume.skills} />
      </div>
    )
  }

  {
    resume.education.length > 0 && (
      <div class="block">
        <h3 class="block-title bw-tape">Education</h3>
        <ul class="education-list">
          {resume.education.map((edu) => {
            const credential = [edu.studyType, edu.area].filter(Boolean).join(', ');
            const dates = formatDateRange(edu.startDate ?? '', edu.endDate);
            return (
              <li>
                <span class="school">{edu.institution}</span>
                {credential && <span class="credential">{credential}</span>}
                {(edu.startDate || edu.endDate) && <span class="dates">{dates}</span>}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</section>
<section>
  <figure class="snapshot" data-reveal>
      <img
        class="snapshot-img"
        src="/me-pixels.png"
        alt="A pixelated black-and-white photo of me as a child at an early computer"
        width="512"
        height="512"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="snapshot-cap bw-tape">Where it started</figcaption>
    </figure>
</section>

<style>
  .resume {
    padding-block: var(--space-16);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-10);
  }

  .block + .block {
    margin-top: var(--space-16);
  }

  /* Stamped tape-label section markers (.bw-tape owns the look). */
  .block-title {
    margin-bottom: var(--space-8);
  }

  .experience-list {
    display: grid;
    gap: var(--space-10);
  }

  .education-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .education-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .school {
    font-weight: var(--weight-bold);
    color: var(--text-strong);
  }

  .credential {
    color: var(--text-secondary);
  }

  .education-list .dates {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  /* Snapshot: a printed photo stamped into the colophon. */
  .snapshot {
    position: relative;
    /* Centered horizontally in the footer's column stack. */
    align-self: center;
    margin: var(--space-6) auto var(--space-10);
  }

  .snapshot-img {
    display: block;
    width: clamp(8rem, 26vw, 15.5rem);
    height: auto;
    /* Keep the dither crisp and proudly blocky. */
    image-rendering: pixelated;
    background: var(--surface-card);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* Lift the print and snap its shadow to brand red on hover. */
  .snapshot:hover .snapshot-img {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-accent);
  }

  /* Tape caption stuck on the bottom-left corner. */
  .snapshot-cap {
    position: absolute;
    left: calc(-1 * var(--space-3));
    bottom: calc(-1 * var(--space-3));
  }

</style>
