---
/* Sticky site header: wordmark + in-page anchor navigation. */
import { site } from '../data/site';

const navItems = [
  { label: 'About', href: '/#about' },
  { label: 'Work', href: '/#work' },
  { label: 'Resume', href: '/resume' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="#top" aria-label={`${site.logo} — home`}>
      <img src="/wordmark.png" alt="" width="796" height="221" />
    </a>
    <div class="right">
      <nav aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-bold) solid var(--border-strong);
  }

  .inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: var(--space-3) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  /* Wordmark on a hard-stamped ink plate so the light logo + rainbow stripe
     read on the cream base; the plate's border flips light in dark mode. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    background: var(--ink-900);
    border-radius: var(--radius-sm);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .wordmark img {
    height: 1.3rem;
    width: auto;
  }

  .wordmark:hover {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
  }

  /* Nav items wear the recurring mono tape-label voice. */
  nav a {
    font-family: var(--font-mono);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-secondary);
    transition: color var(--transition);
  }

  nav a:hover {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  @media (max-width: 30rem) {
    .right {
      gap: var(--space-4);
    }

    nav ul {
      gap: var(--space-4);
    }
  }
</style>
