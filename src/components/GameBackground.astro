---
/*
 * Asteroids background game. The canvas sits above the dot grid (z-index -1 vs
 * -2) and autoplays as ambient motion. When the header's play button is pressed,
 * the engine sets <html data-game="play">; the CSS here promotes the canvas to a
 * foreground overlay, dims the site behind it, and reveals the HUD + on-screen
 * controls. See `scripts/asteroids/`.
 *
 * Reduced-motion / no-JS safety: the script only runs (and only reveals the
 * header button) when motion is allowed; otherwise the canvas stays blank.
 */
---

<canvas id="game-bg" aria-hidden="true"></canvas>

<div class="game-overlay">
  <div class="game-hud">
    <span class="bw-label">Score <b data-game-score>0</b></span>
    <span class="bw-label">Lives <b data-game-lives>3</b></span>
    <span class="bw-label">Wave <b data-game-wave>1</b></span>
    <span class="bw-label">Best <b data-game-best>0</b></span>
    <button class="game-close" type="button" aria-label="Exit game" data-game-close>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <line x1="5.5" y1="5.5" x2="18.5" y2="18.5"></line>
        <line x1="18.5" y1="5.5" x2="5.5" y2="18.5"></line>
      </svg>
    </button>
  </div>

  <p class="game-wave-banner bw-label" data-game-wave-banner aria-hidden="true"></p>

  <div class="game-over" data-game-over hidden>
    <p class="game-over-title bw-label">Game Over</p>
    <div class="game-board" data-game-board></div>
    <form class="game-newscore" data-game-newscore hidden>
      <label class="game-newscore-label bw-label" for="game-name">
        New high score — enter your initials
      </label>
      <div class="game-newscore-row">
        <input
          id="game-name"
          data-game-name
          type="text"
          maxlength="3"
          autocomplete="off"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="AAA"
        />
        <button type="submit">Save</button>
      </div>
    </form>
    <p class="game-over-hint bw-label">Press Space or tap to restart</p>
  </div>

  <div class="game-touch" aria-hidden="true">
    <div class="game-touch-left">
      <button type="button" aria-label="Rotate left" data-game-control="left">◀</button>
      <button type="button" aria-label="Rotate right" data-game-control="right">▶</button>
    </div>
    <div class="game-touch-right">
      <button type="button" aria-label="Thrust" data-game-control="thrust">▲</button>
      <button type="button" aria-label="Fire" data-game-control="fire">●</button>
    </div>
  </div>
</div>

<style>
  #game-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1; /* above the dot grid (-2), below content */
    pointer-events: none;
    color: var(--text-secondary);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  #game-bg.is-ready {
    opacity: 1;
  }

  /* When playing, the canvas becomes the foreground play surface. */
  :global(:root[data-game='play']) #game-bg {
    z-index: 50;
    pointer-events: auto;
    cursor: crosshair;
  }

  /* Overlay chrome (HUD, message, touch pads) — hidden until playing. */
  .game-overlay {
    position: fixed;
    inset: 0;
    z-index: 51;
    display: none;
    pointer-events: none; /* children that need taps opt back in */
  }

  :global(:root[data-game='play']) .game-overlay {
    display: block;
  }

  .game-hud {
    position: absolute;
    /* The header slides away during play, so the HUD sits at the top of the
       window. */
    top: var(--space-4);
    right: var(--space-5);
    left: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .game-hud b {
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .game-close {
    margin-left: auto;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-h-sm);
    height: var(--control-h-sm);
    padding: 0;
    color: var(--text-strong);
    background: var(--surface-card);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      color var(--transition);
  }

  .game-close:hover {
    color: var(--accent);
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-hard-sm);
  }

  .game-close:active {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  .game-close svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* Game-over panel: title + shared leaderboard + (conditional) name form. */
  .game-over {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(22rem, calc(100vw - 2 * var(--space-5)));
    max-height: min(80vh, 36rem);
    overflow: auto;
    padding: var(--space-4) var(--space-5);
    background: var(--surface-card);
    border: var(--border-bold) solid var(--border-strong);
    box-shadow: var(--shadow-hard);
    color: var(--text-strong);
    text-align: center;
    pointer-events: auto; /* allow scrolling + form interaction */
  }

  .game-over-title {
    margin: 0 0 var(--space-3);
    color: var(--accent);
    font-size: var(--text-lg);
  }

  /* Leaderboard rows: rank | name | score. The rows are created in JS (see
     leaderboard.ts), so these selectors must be :global — Astro's scoped styles
     only attach to elements present in this template, not to dynamic nodes. */
  .game-board {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .game-board :global(.game-board-row) {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .game-board :global(.game-board-row.is-you) {
    background: var(--accent);
    color: var(--text-on-accent);
    border-radius: var(--radius-sm);
  }

  .game-board :global(.game-board-rank) {
    color: var(--text-secondary);
  }

  .game-board :global(.game-board-row.is-you .game-board-rank) {
    color: inherit;
  }

  .game-board :global(.game-board-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .game-board :global(.game-board-score) {
    font-weight: var(--weight-bold);
  }

  .game-board :global(.game-board-empty) {
    margin: var(--space-2) 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  /* New-high-score form. */
  .game-newscore {
    margin-top: var(--space-4);
  }

  .game-newscore-label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--accent);
  }

  .game-newscore-row {
    display: flex;
    gap: var(--space-2);
  }

  .game-newscore-row input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    /* Three-initial arcade entry: centred, spaced, always uppercase. */
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.5em;
    text-indent: 0.5em; /* offset the trailing letter-spacing so glyphs sit centred */
    color: var(--text-strong);
    background: var(--surface-inset);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .game-newscore-row input::placeholder {
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .game-newscore-row button {
    flex: none;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-on-accent);
    background: var(--accent);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .game-newscore-row button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .game-over-hint {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }

  /* "Wave N" transient banner — above centre so it never overlaps game-message. */
  .game-wave-banner {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translateX(-50%);
    padding: var(--space-2) var(--space-4);
    background: color-mix(in srgb, var(--surface-card) 85%, transparent);
    border: var(--border-bold) solid var(--border-strong);
    box-shadow: var(--shadow-hard-sm);
    color: var(--text-strong);
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  @keyframes wave-banner-show {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(-4px);
    }
    15% {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    70% {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) translateY(2px);
    }
  }

  .game-wave-banner.is-shown {
    animation: wave-banner-show 1.6s ease forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .game-wave-banner.is-shown {
      animation: none;
      opacity: 0;
    }
  }

  /* Touch pads: only on coarse pointers, and only while playing. */
  .game-touch {
    display: none;
  }

  @media (pointer: coarse) {
    :global(:root[data-game='play']) .game-touch {
      display: block;
    }
  }

  .game-touch-left,
  .game-touch-right {
    position: absolute;
    bottom: var(--space-6);
    display: flex;
    gap: var(--space-3);
  }

  .game-touch-left {
    left: var(--space-5);
  }

  .game-touch-right {
    right: var(--space-5);
  }

  .game-touch button {
    pointer-events: auto;
    width: 3.25rem;
    height: 3.25rem;
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--text-strong);
    background: color-mix(in srgb, var(--surface-card) 78%, transparent);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    touch-action: none;
  }

  .game-touch button:active {
    color: var(--accent);
    transform: translate(1px, 1px);
  }

  @media (prefers-reduced-motion: reduce) {
    #game-bg {
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/asteroids/index';
</script>
