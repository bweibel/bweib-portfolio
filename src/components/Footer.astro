---
/* Site footer. */
import { site } from '../data/site';
import LightToggle from './LightToggle.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <figure class="snapshot" data-reveal>
    <img
      class="snapshot-img"
      src="/me-pixels.png"
      alt="A pixelated black-and-white photo of me as a child at an early computer"
      width="512"
      height="512"
      loading="lazy"
      decoding="async"
    />
    <figcaption class="snapshot-cap bw-tape">Where it started</figcaption>
  </figure>

  <div class="inner">
    <LightToggle />

    <p>&copy; {year} {site.name}. Built with Astro.</p>
    <a href="#top">Back to top ↑</a>
  </div>
  <div class="stripes" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-8);
    border-top: var(--border-bold) solid var(--border-strong);
    /* Stack the snapshot, the meta row, then the signal stripes. */
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .inner {
    max-width: var(--max-width);
    width: 100%;
    margin-inline: auto;
    padding: var(--space-3) var(--space-5);
    gap: var(--space-4);
    display: flex;
    justify-content: space-between;
  }

  /* Snapshot: a printed photo stamped into the colophon. */
  .snapshot {
    position: relative;
    /* Centered horizontally in the footer's column stack. */
    align-self: center;
    margin: var(--space-6) 0 var(--space-10);
  }

  .snapshot-img {
    display: block;
    width: clamp(8rem, 26vw, 20.5rem);
    height: auto;
    /* Keep the dither crisp and proudly blocky. */
    image-rendering: pixelated;
    background: var(--surface-card);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* Lift the print and snap its shadow to brand red on hover. */
  .snapshot:hover .snapshot-img {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-accent);
  }

  /* Tape caption stuck on the bottom-left corner. */
  .snapshot-cap {
    position: absolute;
    left: calc(-1 * var(--space-3));
    bottom: calc(-1 * var(--space-3));
  }

  /* Three signal lines (teal · amber · red) that start at the left screen edge
     (stacked up the edge, bottom line flush to the bottom), rise up-right at 45°,
     then run horizontal to the right edge, keeping constant spacing through the
     bend. Scaled by height (auto width) so the angle stays a true 45° and the
     lines reach the right edge; pinned left so the turn sits at the start. */
  .stripes {
    width: 100%;
    height: var(--space-16);
    background-image: url('/footer-stripes.svg');
    background-repeat: no-repeat;
    background-position: left center;
    background-size: auto 100%;
  }

  a {
    text-decoration: none;
    color: var(--text-secondary);
  }

  a:hover {
    color: var(--accent);
  }
</style>
