---
/* Site footer. */
import { site } from '../data/site';
import LightToggle from './LightToggle.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <LightToggle />

    <p>&copy; {year} {site.name}. Built with Astro.</p>
    <a href="#top">Back to top ↑</a>
  </div>
  <div class="stripes" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-8);
    border-top: var(--border-bold) solid var(--border-strong);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .inner {
    max-width: var(--max-width);
    width: 100%;
    margin-inline: auto;
    padding: var(--space-3) var(--space-5);
    gap: var(--space-4);
    display: flex;
    justify-content: space-between;
  }

  /* Three signal lines (teal · amber · red) that start at the left screen edge
     (stacked up the edge, bottom line flush to the bottom), rise up-right at 45°,
     then run horizontal to the right edge, keeping constant spacing through the
     bend. Scaled by height (auto width) so the angle stays a true 45° and the
     lines reach the right edge; pinned left so the turn sits at the start. */
  .stripes {
    width: 100%;
    height: var(--space-16);
    background-image: url('/footer-stripes.svg');
    background-repeat: no-repeat;
    background-position: left center;
    background-size: auto 100%;
  }

  a {
    text-decoration: none;
    color: var(--text-secondary);
  }

  a:hover {
    color: var(--accent);
  }
</style>
