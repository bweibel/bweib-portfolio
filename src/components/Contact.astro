---
/*
 * Contact section: a form that POSTs to /contact.php (a server-side handler on
 * Hostinger) plus social links. The recipient email lives only in contact.php,
 * so it never appears in the page source. The form works without JS via a
 * plain POST; the inline script upgrades it to a fetch() with inline status.
 */
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
---

<section id="contact" class="contact">
  <p class="eyebrow bw-tape">Let's talk</p>
  <h2 data-reveal>Contact</h2>

  <form class="form" action="/contact.php" method="POST" novalidate data-reveal>
    <div class="field">
      <label for="contact-name">Name</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        maxlength="100"
        required
        autocomplete="name"
      />
    </div>

    <div class="field">
      <label for="contact-email">Email</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        maxlength="254"
        required
        autocomplete="email"
      />
    </div>

    <div class="field">
      <label for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="5" maxlength="5000" required></textarea>
    </div>

    {/* Honeypot: hidden from humans; bots that fill it are silently dropped. */}
    <div class="hp" aria-hidden="true">
      <label for="contact-company">Company</label>
      <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <Button type="submit" variant="ghost">Send message</Button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>

  <div class="or">or find me on</div>
  <SocialLinks />
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact .form');
  const status = form?.querySelector<HTMLParagraphElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;

    button.disabled = true;
    status.textContent = 'Sending…';
    status.classList.remove('is-error', 'is-success');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await response.json().catch(() => ({}));

      if (response.ok && data.ok) {
        status.textContent = data.message ?? 'Thanks — your message has been sent.';
        status.classList.add('is-success');
        form.reset();
      } else {
        status.textContent = data.message ?? 'Something went wrong. Please try again.';
        status.classList.add('is-error');
      }
    } catch {
      status.textContent = 'Network error. Please try again.';
      status.classList.add('is-error');
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .contact {
    padding-block: var(--space-16);
    border-top: var(--border-bold) solid var(--border-strong);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-5);
  }

  .lead {
    max-width: var(--max-width-prose);
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .form {
    margin-top: var(--space-8);
    max-width: var(--max-width-prose);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  label {
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  input,
  textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-inset);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-strong);
    font-family: var(--font-sans);
    font-size: var(--text-base);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: var(--border-bold) solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Honeypot field: removed from layout and the tab order, kept in the DOM. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .status {
    margin-top: var(--space-4);
    min-height: 1.2em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .status.is-success {
    color: var(--accent);
  }

  .status.is-error {
    color: var(--accent-2, var(--text-strong));
  }

  /* Mono tape-label connector. */
  .or {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
</style>
