---
/* Small CTA nudging visitors to the dedicated resume page. */
import Button from './Button.astro';
---

<section class="resume-cta">
  <p class="eyebrow bw-tape variant-accent-3">Background</p>
  <h2>Resume</h2>
  <p class="lead">
    I've been building on the web for years.
  </p>
  <Button href="/resume" variant='accent-2'>View full resume</Button>
</section>

<style>
  .resume-cta {
    padding-block: var(--space-16);
    border-top: var(--border-bold) solid var(--border-strong);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
  }

  h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-5);
  }

  .lead {
    max-width: var(--max-width-prose);
    color: var(--text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-8);
  }
</style>
