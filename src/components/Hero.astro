---
/* About/intro section: name, role, optional tagline, and bio. */
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<section id="about" class="hero">
  <p class="eyebrow">{site.role}</p>
  <h1>{site.name}</h1>
  {site.tagline && <p class="tagline">{site.tagline}</p>}
  <p class="bio">{site.bio}</p>
  <div class="actions">
    <a class="cta" href="#contact">Get in touch</a>
    <SocialLinks />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-20) var(--space-16);
  }

  /* Mono tape-label eyebrow. */
  .eyebrow {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-5xl);
    letter-spacing: var(--tracking-tight);
  }

  .tagline {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin-top: var(--space-4);
  }

  .bio {
    max-width: var(--max-width-prose);
    font-size: var(--text-lg);
    color: var(--text-body);
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  /* Hard-stamped button: bold border + offset shadow, presses into its shadow. */
  .cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background-color: var(--accent);
    color: var(--text-on-accent);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard);
    text-decoration: none;
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--transition);
  }

  .cta:hover {
    background-color: var(--accent-hover);
    color: var(--text-on-accent);
  }

  .cta:active {
    transform: translate(var(--press-shift), var(--press-shift));
    box-shadow: var(--shadow-hard-xs);
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: var(--text-4xl);
    }
  }
</style>
