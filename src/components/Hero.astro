---
/* About/intro section: name, role, optional tagline, and bio. */
import { site } from '../data/site';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
---

<section id="about" class="hero" data-anim="hero">
  <p class="eyebrow">{site.role}</p>
  <h1>Hi, I'm {site.name}</h1>
  {site.tagline && <p class="tagline">{site.tagline}</p>}
  <p class="bio">{site.bio}</p>
  <div class="actions">
    <Button href="#contact">Get in touch</Button>
    <SocialLinks />
  </div>

  <a class="scroll-cue" href="#work" aria-label="Scroll to projects">
    <svg
      class="scroll-cue-arrow"
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </a>
</section>

<style>
  /* Fill the viewport below the sticky header on first load (~3rem tall). */
  .hero {
    position: relative;
    min-height: calc(100svh - 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Symmetric padding so the content sits at true vertical center. */
    padding-block: var(--space-16);
  }

  /* Hard-stamped scroll cue, anchored bottom-left to the content column. */
  .scroll-cue {
    position: absolute;
    bottom: var(--space-6);
    left: 0;
    display: inline-flex;
    padding: var(--space-2);
    color: var(--text-secondary);
    background: var(--surface-card);
    border: var(--border-bold) solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-hard-sm);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      color var(--transition);
  }

  .scroll-cue:hover {
    color: var(--accent);
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-hard);
  }

  .scroll-cue:active {
    transform: translate(1px, 1px);
    box-shadow: var(--shadow-hard-xs);
  }

  /* Subtle idle bounce. Disabled by the global prefers-reduced-motion rule. */
  .scroll-cue-arrow {
    animation: scroll-bounce 1.8s var(--ease-in-out) infinite;
  }

  @keyframes scroll-bounce {
    0%,
    100% {
      transform: translateY(-1px);
    }
    50% {
      transform: translateY(3px);
    }
  }

  /* Mono tape-label eyebrow. */
  .eyebrow {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-5xl);
    letter-spacing: var(--tracking-tight);
  }

  .tagline {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin-top: var(--space-4);
  }

  .bio {
    max-width: var(--max-width-prose);
    font-size: var(--text-lg);
    color: var(--text-body);
    margin-top: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: var(--text-4xl);
    }
  }
</style>
