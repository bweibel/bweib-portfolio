---
/*
 * Interactive grid background: a field of dots warped by the pointer, easing
 * home. Canvas 2D, no dependencies. Sits behind all content (z-index -1,
 * pointer-events none) so cards and text read over it untouched.
 *
 * Reduced-motion / no-JS safety: the canvas only animates when the visitor
 * allows motion. Otherwise it stays blank and the page looks exactly as before.
 */
interface Props {
  /** Interaction style. See `scripts/grid-background.ts`. */
  variant?: 'pull' | 'repel' | 'lines';
}
const { variant = 'lines' } = Astro.props;
---

<canvas id="grid-bg" data-variant={variant} aria-hidden="true"></canvas>

<style>
  #grid-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    /* Source of the dot colour: the script reads this resolved value back so
       the grid tracks the light/dark theme. */
    color: var(--text-secondary);
    /* Cheap fade-in once the first frame paints (set by the script). */
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  #grid-bg.is-ready {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/grid-background';
</script>
